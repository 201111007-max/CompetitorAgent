# ==================== Logs ====================
# 日志文件 - dota_helper/logs/ 目录
# 结构: logs/YYYY-MM-DD/part-N/*.log
dota_helper/logs/
*.log
*.json.log

# ==================== Cache ====================
# 缓存数据库文件 - dota_helper/cache/cache.db
dota_helper/cache/*.db

# API数据缓存文件 - 英雄克制数据等
# 这些文件可以通过API重新获取，不需要提交到git
dota_helper/cache/hero_matchups_*.json
dota_helper/cache/heroes_list.json

# Matchup 数据目录 - 英雄对局数据本地存储
dota_helper/data/matchups/

# 通用数据库文件
*.db
*.sqlite
*.sqlite3

# ==================== Knowledge Management ====================
# 向量数据库存储目录 - Chroma 持久化数据
dota_helper/data/chroma_db/

# 本地 Embedding 模型缓存
.cache/
*.cache/

# 知识库临时文件
*.index
*.faiss

# ==================== Runtime Data ====================
# 运行时数据目录
memory_runtime/
cache_runtime/

# ==================== Test Data ====================
# 测试数据目录
test_memory/
test_prefix/
dota_helper/test_cache/

# OS files
.DS_Store
Thumbs.db

# Output projects
out_project/

# Trae IDE
.trae/

# Superpowers
.superpowers/

# ==================== Local Docs (not for GitHub) ====================
# 个人/过程性文档 - 仅本地保留，不上传到 GitHub
dota_helper/docs/

# ==================== Post Match Review Reports ====================
# 复盘报告输出目录 - 包含生成的 Markdown 报告，不上传到 git
dota_helper/reports/

# ==================== Competitor Agent Reports ====================
