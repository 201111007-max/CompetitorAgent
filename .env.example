OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Langfuse Configuration
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_HOST=http://localhost:3000

MODELSCOPE_CACHE=D:\ollama_models

# dota_helper LLM Configuration (可选)
# 更详细的配置请参考 dota_helper/config/llm_config.yaml
# DOTA_LLM_ENABLED=true
# DOTA_LLM_BASE_URL=http://127.0.0.1:1234/v1
# DOTA_LLM_MODEL=qwen3.5-9b

# DeepSeek API Key（推荐，dota_helper 使用）
# 从 https://platform.deepseek.com/ 获取
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenDota API Key（可选，用于提高 API 请求限制）
# 从 https://www.opendota.com/ 获取
OPENDOTA_API_KEY=your_opendota_api_key_here
