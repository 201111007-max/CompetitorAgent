# 设计文档 55 M3：.env 模板——复制为 .env 后填值（.env 已被 gitignore，密钥不落库）
# 全部变量均为运行时注入，镜像/compose 零密钥。

# === LLM（必填其一，别名链：OPENAI_API_KEY > DEEPSEEK_API_KEY > LLM_API_KEY） ===
OPENAI_API_KEY=
# OpenAI 兼容端点（DeepSeek 等自建网关），缺省走官方 OpenAI
OPENAI_BASE_URL=

# === Web 安全（可选） ===
# 设置后所有 /api/* 需携带 Authorization: Bearer <token>；留空则不要求鉴权（仅本机使用时）
COMPETITOR_AUTH_TOKEN=

# === Tavily 搜索（可选，doc 66/71） ===
# 配置后（collector.search_provider=tavily + enable_external_sources=true）DDG 失败时降级
# 到真实 Tavily 搜索；未配置则仅用 DDG 免费主力（无 Key 恒可用），降级池无 Tavily
TAVILY_API_KEY=

# === 搜索与抓取两层架构（doc 71，全部可选） ===
# Jina Reader 提额（抓取第 3 级云端兜底；缺省免费档限 20 次/分）
JINA_API_KEY=
# 纯搜索模式总开关：1（默认，抓取层启用）| 0/false → 完全禁用抓取层（只读搜索摘要）
FETCH_ENABLED=
# 单次任务最大抓取次数（懒触发防失控，默认 6）
FETCH_MAX_PER_RUN=
# 抓取正文长度上限（默认 8000，对齐 max_content_chars）
FETCH_MAX_CHARS=
# crawl4ai 浏览器无头模式（默认 true）与单次抓取/空闲回收超时（默认 30s）
CRAWL4AI_HEADLESS=
CRAWL4AI_TIMEOUT=

# === Langfuse 链路追踪（可选，doc 54；三变量齐全才启用 exporter） ===
# compose + observability profile 时保持缺省即可（web 缺省指向 http://langfuse:3000）；
# 用外部 Langfuse Cloud 时改成 https://cloud.langfuse.com
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# === observability profile 的 Langfuse/Postgres 本地占位密钥（可选覆盖） ===
# 缺省值仅适合本机开发；暴露到共享网络前务必替换为强随机值
POSTGRES_PASSWORD=
NEXTAUTH_SECRET=
SALT=
